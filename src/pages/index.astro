---
// The site root sends visitors to the default locale.
import { url } from "../lib/site";
const target = url("en/");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content={`0; url=${target}`}>
  <link rel="canonical" href={target}>
  <title>Studium</title>
</head>
<body><a href={target}>Studium</a></body>
</html>
